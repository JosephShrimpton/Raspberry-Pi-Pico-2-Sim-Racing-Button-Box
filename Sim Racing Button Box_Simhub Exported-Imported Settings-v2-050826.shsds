      "Message": {
        "Expression": "IF([ATSRHubMain.Telemetry.Vehicle.FuelLevel] / [DataCorePlugin.Computed.Fuel_LitersPerLap] <= 3, 'LED1_FADE_FLASH_100', 'LED1_OFF') + '\\n'"
      },
